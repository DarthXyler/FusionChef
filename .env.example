# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_OCR_MODEL=

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_QUERY_TIMEOUT_MS=8000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fusion-cooking
R2_PUBLIC_BASE_URL=

# Internal/admin protection
INTERNAL_API_TOKEN=
CRON_SECRET=
MONETIZATION_ADMIN_TOKEN=
ADMIN_AUTH_EMAIL_ALLOWLIST=

# Google OAuth for admin login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_SESSION_SECRET=

# Monetization
RATE_LIMIT_BACKEND=turso
MONETIZATION_CREDIT_PACKS_JSON={"apple_app_store":{"com.flavorfusion.credits.20":20,"com.flavorfusion.credits.50":50,"com.flavorfusion.credits.120":120},"google_play":{"credits_20_android":20,"credits_50_android":50,"credits_120_android":120}}
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.flavorfusionchef.mobile
APPLE_SIGN_IN_AUDIENCE=com.flavorfusionchef.mobile

# Optional legacy web generator switch
WEB_FUSION_ENABLED=false
